# Pyth Hermes requires an API key as of the Aug 2026 Hermes upgrade.
# Sign up for a free Pyth Terminal account, then "View your API key":
# https://docs.pyth.network/price-feeds/pro/acquire-api-key
# Server-side only — never expose this in client code.
PYTH_API_KEY=

# A paid-tier Solana RPC endpoint (Helius/Triton). Public mainnet RPC will
# rate-limit during a live demo — do not rely on it.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Same as above, but for the browser (wallet connect, reading a visitor's
# own token balances). Must start with NEXT_PUBLIC_ to reach client code.
# Safe to make public — it's read-only and not tied to any account.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Set to "pyth" once Pyth grants access to the Equity.US.* and Crypto.*X
# feeds this project needs (see docs/submission.md). Any other value, or
# leaving this unset, uses the free Jupiter + Yahoo Finance fallback.
MARKET_DATA_SOURCE=free

# Only needed once the Gap Insurance settlement/redemption flow is wired up.
# JSON array secret key (same format Solana CLI keypair files use) for the
# treasury that signs settlement memos and executes custodial payouts.
# NEVER commit this file with a real value filled in.
TREASURY_KEYPAIR_SECRET=

# Everything below is only for the devnet Gap Insurance test pool — a free,
# real, working proof of the mechanism that costs nothing. Leave these
# unset entirely for a mainnet deployment; SOLANA_RPC_URL and
# NEXT_PUBLIC_SOLANA_RPC_URL above stay mainnet either way, since Radar and
# Portfolio always need real chain data.
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_PROTECTION_POOL=
DEVNET_RPC_URL=https://api.devnet.solana.com
DEVNET_MOCK_USDC_MINT=
