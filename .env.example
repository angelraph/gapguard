# Pyth Hermes requires an API key as of the Aug 2026 Hermes upgrade.
# Sign up for a free Pyth Terminal account, then "View your API key":
# https://docs.pyth.network/price-feeds/pro/acquire-api-key
# Server-side only — never expose this in client code.
PYTH_API_KEY=

# A paid-tier Solana RPC endpoint (Helius/Triton). Public mainnet RPC will
# rate-limit during a live demo — do not rely on it.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: a better mainnet RPC for the browser's mainnet quotes. Must
# start with NEXT_PUBLIC_. Read-only, safe to be public.
NEXT_PUBLIC_MAINNET_RPC_URL=

# Pyth is the primary price source whenever PYTH_API_KEY is set. If Pyth
# errors, the app falls back to Jupiter plus Yahoo Finance automatically.
# Set MARKET_DATA_SOURCE=free to force the free source instead.
# MARKET_DATA_SOURCE=free

# Only needed once the Gap Insurance settlement/redemption flow is wired up.
# JSON array secret key (same format Solana CLI keypair files use) for the
# treasury that signs settlement memos and executes custodial payouts.
# NEVER commit this file with a real value filled in.
TREASURY_KEYPAIR_SECRET=

# Gap Insurance runs on two networks at once and visitors pick one on the
# page: mainnet (real money) and devnet (a free test network with a faucet).
# Pool addresses come from running the create-pool scripts. Leave a pool
# unset and that tab says there's no pool yet.
NEXT_PUBLIC_PROTECTION_POOL_MAINNET=
NEXT_PUBLIC_PROTECTION_POOL_DEVNET=

# Public key (not secret) of the dedicated mainnet wallet that created the
# mainnet pool and writes its settlement record. Its keypair lives in
# scripts/mainnet/treasury.json, which is git-ignored.
TREASURY_ADDRESS_MAINNET=

# Devnet only: server-side RPC and the free test USDC mint the faucet mints.
DEVNET_RPC_URL=https://api.devnet.solana.com
DEVNET_MOCK_USDC_MINT=
